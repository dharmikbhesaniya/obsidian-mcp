# Server Configuration
NODE_ENV=production
MCP_TRANSPORT=http
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=https://mcp.yourdomain.com

# Vault Configuration
# Option 1: Single primary vault
OBSIDIAN_VAULT_PATH=/srv/obsidian/vault

# Option 2: Multiple named vaults (JSON or comma-separated name=path pairs)
# OBSIDIAN_VAULTS={"personal": "/srv/obsidian/personal", "work": "/srv/obsidian/work"}
# OBSIDIAN_VAULTS=personal=/srv/obsidian/personal,work=/srv/obsidian/work
# OBSIDIAN_DEFAULT_VAULT=work

OBSIDIAN_BIN_PATH=/usr/bin/obsidian

# Security & Authentication
AUTH_ENABLED=true
# SHA-256 hash of your Bearer access token
BEARER_TOKEN_HASH=

# Operational Limits
RATE_LIMIT_PER_MINUTE=120
MAX_SEARCH_RESULTS=50
COMMAND_TIMEOUT_MS=15000

# Feature Flags
ENABLE_ADVANCED_CLI=false
ENABLE_DESTRUCTIVE_TOOLS=true

# Logging
LOG_LEVEL=info
