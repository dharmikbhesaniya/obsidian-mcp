# Server Configuration
NODE_ENV=production
MCP_TRANSPORT=http
PORT=9435
HOST=127.0.0.1
PUBLIC_URL=https://mcp.yourdomain.com

# Vault Configuration
# Option 1: Single primary vault
OBSIDIAN_VAULT_PATH=/srv/obsidian/vault

# Option 2: Multiple named vaults with per-vault access levels (:ro for read-only, :rw for read-write)
# Syntax A: Comma-separated pairs with optional :ro / :rw suffix
# OBSIDIAN_VAULTS=personal=/srv/obsidian/personal:ro,work=/srv/obsidian/work:rw
# Syntax B: Comma-separated vaults + dedicated read-only list
# OBSIDIAN_VAULTS=personal=/srv/obsidian/personal,work=/srv/obsidian/work
# OBSIDIAN_READ_ONLY_VAULTS=personal
# Syntax C: JSON dictionary with path and readOnly / scopes
# OBSIDIAN_VAULTS={"personal": {"path": "/srv/obsidian/personal", "readOnly": true}, "work": "/srv/obsidian/work"}
# OBSIDIAN_DEFAULT_VAULT=work

OBSIDIAN_BIN_PATH=/usr/bin/obsidian

# Security & Authentication
AUTH_ENABLED=true
# Option A: Direct secret Bearer token (e.g. "my-secret-token", auto-hashed with SHA-256)
AUTH_TOKEN=
# Option B: Alias for secret Bearer token
# BEARER_TOKEN=
# Option C: Pre-computed SHA-256 hex digest of your Bearer access token (for zero-trust setups)
# (Note: If a plaintext token is entered here, the server will also detect and automatically hash it!)
BEARER_TOKEN_HASH=

# Access Control & Permissions
# Set to true to restrict the server strictly to read-only operations (vault:read)
READ_ONLY=false
# Optional granular comma-separated scopes: vault:read,vault:write,vault:delete,vault:admin,vault:developer
SCOPES=

# Operational Limits
RATE_LIMIT_PER_MINUTE=120
MAX_SEARCH_RESULTS=50
COMMAND_TIMEOUT_MS=15000

# Feature Flags
ENABLE_ADVANCED_CLI=false
ENABLE_DESTRUCTIVE_TOOLS=true

# Logging
LOG_LEVEL=info
