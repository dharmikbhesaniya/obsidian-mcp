{
  "name": "obsidian-remote-mcp",
  "version": "0.1.0",
  "description": "Secure, typed Model Context Protocol (MCP) server for remote Obsidian knowledge systems",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "obsidian-remote-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dharmikbhesaniya/obsidian-mcp.git"
  },
  "homepage": "https://github.com/dharmikbhesaniya/obsidian-mcp#readme",
  "bugs": {
    "url": "https://github.com/dharmikbhesaniya/obsidian-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "npx @modelcontextprotocol/inspector@latest node dist/index.js",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "agent-skills",
    "obsidian-skill",
    "ai",
    "knowledge-base",
    "pkm",
    "claude",
    "chatgpt"
  ],
  "author": "Dharmik Bhesaniya",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  }
}
