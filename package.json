{
  "name": "obsidian-mcp",
  "version": "0.1.0",
  "description": "Secure, typed Model Context Protocol (MCP) server for remote Obsidian knowledge systems",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ --ext .ts"
  },
  "keywords": [
    "obsidian",
    "mcp",
    "model-context-protocol",
    "ai",
    "knowledge-base",
    "pkm",
    "claude",
    "chatgpt"
  ],
  "author": "Dharmik Bhesaniya",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
